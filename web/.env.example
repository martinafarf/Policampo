# Copiá este archivo como ".env.local" y completá los valores. ".env.local" NO se sube (está en .gitignore).
#
# Cadena de conexión a PostgreSQL en Neon. Se obtiene con:
#   neonctl connection-string --project-id <id-del-proyecto> --pooled
# o desde la consola de Neon (Connect). En Vercel se carga como variable del proyecto.
DATABASE_URL=postgresql://usuario:contrasena@servidor.neon.tech/neondb?sslmode=require
