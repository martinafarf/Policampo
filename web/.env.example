# Copiá este archivo como ".env.local" y completá los valores. ".env.local" NO se sube (está en .gitignore).
# Valores reales: pedíselos a quien administra el proyecto, por un canal privado (regla RS-01).
# Trabajo local y vistas previas usan SIEMPRE la rama "desarrollo" de Neon, nunca producción (regla RS-11).

# Conexión de la APP: rol policampo_app (solo lee y escribe datos, regla RS-12), con pooler.
DATABASE_URL=postgresql://policampo_app:contrasena@servidor-pooler.neon.tech/neondb?sslmode=verify-full

# Conexión para MIGRAR: rol policampo_migraciones (puede cambiar el esquema), sin pooler.
# Solo la necesita quien corre "npm run db:migrar". Nunca se carga en Vercel.
DATABASE_URL_MIGRACIONES=postgresql://policampo_migraciones:contrasena@servidor.neon.tech/neondb?sslmode=verify-full

# Autenticación (Better Auth). El secreto firma sesiones y tokens: un valor aleatorio de 32 bytes o más.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=poner-un-valor-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# Emails (Resend). Sin RESEND_API_KEY, en desarrollo los emails se muestran en la consola; en producción es un error.
# La clave se carga a mano en .env.local y en Vercel: nunca se pega en chats ni en el repo (regla RS-01).
RESEND_API_KEY=re_poner-la-clave
# Remitente. Sin dominio propio verificado en Resend, dejarlo vacío: se usa onboarding@resend.dev, que solo
# entrega a la dirección dueña de la cuenta de Resend.
EMAIL_REMITENTE=
EMAIL_CONTACTO=

# Tests: van en otro archivo, web/.env.test.local (también ignorado por Git), con una base DESCARTABLE
# cuyo nombre termine en "_test". Los tests la borran y la recrean.
# TEST_DATABASE_URL=postgresql://usuario:contrasena@servidor.neon.tech/policampo_test?sslmode=verify-full
